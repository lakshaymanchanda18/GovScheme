generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

model User {
  id                String    @id @default(cuid())
  email             String    @unique
  password          String
  firstName         String
  lastName          String
  phone             String?
  dateOfBirth       DateTime?
  address           String?
  city              String?
  state             String?
  pincode           String?
  aadharNumber      String?
  panNumber         String?
  income            Decimal?
  occupation        String?
  education         String?
  familySize        Int?
  disability        String?
  veteranStatus     String?
  createdAt         DateTime  @default(now())
  updatedAt         DateTime  @updatedAt
  isActive          Boolean   @default(true)
  role              String    @default("USER")
  applications      Application[]
  eligibilityChecks  EligibilityCheck[]
  notifications     Notification[]

  @@map("users")
}

model GovernmentScheme {
  id                String    @id @default(cuid())
  name              String
  description       String
  category          String
  department        String
  eligibilityCriteria String
  benefits          String
  applicationProcess String
  requiredDocuments String
  sourceUrl         String?
  incomeLimit       Decimal?
  ageLimit          String?
  familySizeLimit   Int?
  disabilityCriteria String?
  veteranCriteria   String?
  educationCriteria String?
  occupationCriteria String?
  stateSpecific     String?
  isActive          Boolean   @default(true)
  createdAt         DateTime  @default(now())
  updatedAt         DateTime  @updatedAt
  applications      Application[]
  eligibilityChecks  EligibilityCheck[]

  @@map("government_schemes")
}

model Application {
  id                String    @id @default(cuid())
  userId            String
  schemeId          String
  status            String    @default("PENDING")
  submittedAt       DateTime  @default(now())
  reviewedAt        DateTime?
  approvedAt        DateTime?
  rejectedAt        DateTime?
  rejectionReason    String?
  documents         String?   // Store document metadata as JSON string
  applicationData    String?   // Store form data as JSON string
  user              User      @relation(fields: [userId], references: [id])
  scheme            GovernmentScheme @relation(fields: [schemeId], references: [id])
  statusUpdates     ApplicationStatusUpdate[]

  @@map("applications")
}

model EligibilityCheck {
  id                String    @id @default(cuid())
  userId            String
  schemeId          String
  isEligible        Boolean
  confidenceScore   Float?
  matchedCriteria   String?   // Store matched criteria details as JSON string
  unmatchedCriteria String?   // Store unmatched criteria details as JSON string
  checkedAt         DateTime  @default(now())
  user              User      @relation(fields: [userId], references: [id])
  scheme            GovernmentScheme @relation(fields: [schemeId], references: [id])

  @@map("eligibility_checks")
}

model Notification {
  id                String    @id @default(cuid())
  userId            String
  title             String
  message           String
  type              String    @default("INFO")
  isRead            Boolean   @default(false)
  createdAt         DateTime  @default(now())
  user              User      @relation(fields: [userId], references: [id])

  @@map("notifications")
}

model ApplicationStatusUpdate {
  id             String      @id @default(cuid())
  applicationId  String
  status         String
  source         String
  details        String?
  createdAt      DateTime    @default(now())
  application    Application @relation(fields: [applicationId], references: [id])

  @@map("application_status_updates")
}

model AuditLog {
  id          String   @id @default(cuid())
  actorId     String?
  action      String
  entityType  String
  entityId    String?
  metadata    String?
  createdAt   DateTime @default(now())

  @@map("audit_logs")
}
