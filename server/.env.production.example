DATABASE_URL="postgresql://USER:PASSWORD@HOST:PORT/DATABASE?sslmode=require"
JWT_SECRET="replace-with-a-long-random-secret"
JWT_EXPIRE="7d"
NODE_ENV="production"
PORT=5001

# Comma-separate all deployed frontend origins that may call this API.
FRONTEND_URL="https://your-govscheme-frontend.example.com"
CORS_ORIGIN="https://your-govscheme-frontend.example.com"

# RAG / AI
GEMINI_API_KEY="replace-with-google-ai-studio-key"
PINECONE_API_KEY="replace-with-pinecone-key"
PINECONE_INDEX_NAME="gov-schemes"

# Optional email provider config.
EMAIL_HOST=""
EMAIL_PORT=587
EMAIL_USER=""
EMAIL_PASS=""
